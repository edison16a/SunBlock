# Keeps editors from fighting over a repo that has no build step and no
# formatter to fall back on. Everything here is what the files already use.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
