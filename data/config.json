{
  "defaults": {
    "adBlockingEnabled": true,
    "adsBlockedCount": 0,
    "whitelist": []
  },
  "rules": {
    "priority": 1,
    "resourceTypes": [
      "main_frame",
      "sub_frame",
      "stylesheet",
      "script",
      "image",
      "font",
      "xmlhttprequest",
      "ping",
      "csp_report",
      "media",
      "websocket",
      "other"
